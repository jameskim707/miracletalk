rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    // 전체 채팅방(lobby)은 로그인한 누구나, 1:1 방·단체방은 참여자만
    function canUseRoom(roomId) {
      return roomId == 'lobby'
        || request.auth.uid in roomDoc(roomId).data.members;
    }

    // 같은 사람이 두 번 들어가 있지 않은지
    function noDuplicates(list) {
      return list.toSet().size() == list.size();
    }

    // 미리보기용 '마지막 메시지' 모양 검사 (보낸 사람 = 본인)
    function validLastMessage(lm) {
      return lm.keys().hasOnly(['text', 'uid', 'name', 'system'])
        && lm.keys().hasAll(['text', 'uid'])
        && lm.uid == request.auth.uid
        && lm.text is string
        && lm.text.size() <= 100
        && (!('name' in lm) || (lm.name is string && lm.name.size() <= 100))
        && (!('system' in lm) || lm.system == true);
    }

    // ---------- 사용자 프로필 ----------
    match /users/{uid} {
      // 한 명씩 보기는 가능, 목록 조회는 한 번에 1명까지만 (이메일로 친구 찾기용)
      // → 누가 전체 회원 목록을 통째로 긁어가는 것을 막습니다
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 1;

      // 본인만 수정, 이메일은 실제 로그인한 구글 이메일만 저장 가능 (사칭 방지)
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'email', 'lastLogin'])
        && request.resource.data.email == request.auth.token.email.lower();

      // 내 친구 목록: 나만 읽고 쓸 수 있음
      match /friends/{friendUid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && friendUid != uid
          && request.resource.data.keys().hasOnly(['name', 'photo', 'email', 'addedAt']);
      }
    }

    // ---------- 채팅방 ----------
    match /rooms/{roomId} {
      // 1:1 방 만들기: 방 ID는 반드시 dm_{작은uid}_{큰uid}, 내가 참여자여야 함
      function isValidDMCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly(['type', 'members', 'memberInfo', 'createdAt', 'updatedAt', 'lastMessage'])
          && d.type == 'dm'
          && d.members is list
          && d.members.size() == 2
          && request.auth.uid in d.members
          && d.members[0] < d.members[1]
          && roomId == 'dm_' + d.members[0] + '_' + d.members[1]
          && exists(/databases/$(database)/documents/users/$(d.members[0]))
          && exists(/databases/$(database)/documents/users/$(d.members[1]))
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }

      // 단체방 만들기: 만든 사람이 참여자, 2~50명, 방 이름 1~30자
      function isValidGroupCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly(['type', 'name', 'members', 'memberInfo', 'createdBy', 'createdAt', 'updatedAt', 'lastMessage'])
          && d.type == 'group'
          && roomId != 'lobby'
          && !roomId.matches('dm_.*')
          && d.name is string
          && d.name.size() >= 1 && d.name.size() <= 30
          && d.createdBy == request.auth.uid
          && d.members is list
          && request.auth.uid in d.members
          && d.members.size() >= 2 && d.members.size() <= 50
          && noDuplicates(d.members)
          && d.memberInfo is map
          && d.memberInfo.keys().hasAll(d.members)
          && d.lastMessage == null
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }

      // (1) 메시지 보낼 때: 참여자는 '마지막 메시지'와 '갱신 시간'만 바꿈 (1:1, 단체 공통)
      function isMessageUpdate() {
        return request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
          && validLastMessage(request.resource.data.lastMessage)
          && request.resource.data.updatedAt == request.time;
      }

      // (2) 단체방 초대: 참여자만, 기존 사람은 그대로 두고 새 사람만 추가, 최대 50명
      //     memberInfo는 새로 들어온 사람 것만 추가 가능 (남의 이름 바꾸기 금지)
      function isInvite() {
        let before = resource.data;
        let after = request.resource.data;
        let added = after.members.removeAll(before.members);
        let changed = after.diff(before).affectedKeys();
        return before.type == 'group'
          && request.auth.uid in before.members
          && changed.hasOnly(['members', 'memberInfo', 'lastMessage', 'updatedAt'])
          && after.members is list
          && after.members.hasAll(before.members)
          && added.size() >= 1
          && after.members.size() <= 50
          && noDuplicates(after.members)
          && after.memberInfo.diff(before.memberInfo).affectedKeys().hasOnly(added)
          && after.memberInfo.keys().hasAll(added)
          && (!('lastMessage' in changed) || validLastMessage(after.lastMessage))
          && after.updatedAt == request.time;
      }

      // (3) 단체방 나가기: 나 자신만 빠질 수 있음 (남을 내보내기 금지)
      function isLeave() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return before.type == 'group'
          && request.auth.uid in before.members
          && changed.hasOnly(['members', 'lastMessage', 'updatedAt'])
          && after.members == before.members.removeAll([request.auth.uid])
          && (!('lastMessage' in changed) || validLastMessage(after.lastMessage))
          && after.updatedAt == request.time;
      }

      // 없는 방 확인(resource == null)은 허용 → 1:1 방을 처음 만들기 전에 있는지 확인용
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn() && (isValidDMCreate() || isValidGroupCreate());

      allow update: if signedIn() && (isMessageUpdate() || isInvite() || isLeave());

      allow delete: if false;

      // ---------- 방 안의 메시지 ----------
      match /messages/{msgId} {
        allow read: if signedIn() && canUseRoom(roomId);

        // 보내는 사람 = 로그인한 본인, 글자 수 1~1000, 시간은 서버 시간만 허용
        // system: true 는 "OO님이 나갔습니다" 같은 안내 메시지 (단체방에서만)
        allow create: if signedIn()
          && canUseRoom(roomId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'text', 'createdAt', 'system'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && (!('system' in request.resource.data)
              || (request.resource.data.system == true
                  && roomId != 'lobby'
                  && roomDoc(roomId).data.type == 'group'
                  && request.resource.data.text.size() <= 300));

        // 수정/삭제는 아직 막아둠
        allow update, delete: if false;
      }
    }

    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
